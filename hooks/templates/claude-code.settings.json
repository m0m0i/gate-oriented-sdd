{
  "extraKnownMarketplaces": {
    "gate-oriented-sdd": {
      "source": { "source": "github", "repo": "m0m0i/gate-oriented-sdd" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": { "gate-sdd@gate-oriented-sdd": true },
  "env": { "FORCE_AUTOUPDATE_PLUGINS": "1" },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "{{FAST_CHECK}}", "timeout": 60 }
        ]
      }
    ]
  }
}
