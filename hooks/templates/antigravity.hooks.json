{
  "gate-sdd": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; [ -f {{HOOKS_DIR}}/steering-digest-antigravity.sh ] || exit 0; sh {{HOOKS_DIR}}/steering-digest-antigravity.sh",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; [ -f {{HOOKS_DIR}}/quality-gate.sh ] || exit 0; sh {{HOOKS_DIR}}/quality-gate.sh",
        "timeout": 600
      },
      {
        "type": "command",
        "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; [ -f {{HOOKS_DIR}}/review-gate.sh ] || exit 0; sh {{HOOKS_DIR}}/review-gate.sh",
        "timeout": 120
      }
    ]
  },
  "gate-sdd-fast-check": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && ( {{FAST_CHECK}} ) 1>&2; echo '{}'",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
