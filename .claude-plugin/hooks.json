{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/plugin-gate.sh\" quality-gate.sh", "timeout": 180 }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/plugin-gate.sh\" review-gate.sh", "timeout": 30 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/plugin-gate.sh\" steering-digest.sh", "timeout": 15 }
        ]
      }
    ]
  }
}
